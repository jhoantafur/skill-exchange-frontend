components:
  schemas:
    BadgeDetail:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 120
        badge_type:
          $ref: '#/components/schemas/BadgeTypeEnum'
        tier:
          $ref: '#/components/schemas/TierEnum'
        description:
          type: string
        icon_url:
          type: string
          format: uri
          maxLength: 200
        points_required:
          type: integer
          maximum: 2147483647
          minimum: 0
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - updated_at
    BadgeList:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 120
        badge_type:
          $ref: '#/components/schemas/BadgeTypeEnum'
        tier:
          $ref: '#/components/schemas/TierEnum'
        points_required:
          type: integer
          maximum: 2147483647
          minimum: 0
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - updated_at
    BadgeSummary:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
