        name: goal_type
        schema:
          type: string
          enum:
          - certification
          - community
          - contribution
          - mentoring
          - project
          - skill
        description: |-
          * `skill` - Skill
          * `community` - Community
          * `project` - Project
          * `mentoring` - Mentoring
          * `certification` - Certification
          * `contribution` - Contribution
